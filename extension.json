{
	"manifest_version": 2,
	"name": "PageLockdown",
	"version": "2.0",
	"url": "https://www.mediawiki.org/wiki/Extension:PageLockdown",
	"author": "[https://www.hamichlol.org.il/משתמש:מקוה מקוה]",
	"descriptionmsg": "page-lockdown-desc",
	"license-name": "GPL-3.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.45.0"
	},
	"MessagesDirs": {
		"PageLockdown": [
			"i18n"
		]
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\PageLockdown\\": "includes/"
	},
	"GroupPermissions": {
		"pageviewers": {
			"page-lockdown-read": true,
			"page-lockdown-edit": true,
			"page-lockdown-read-confirmed": true,
			"page-lockdown-edit-confirmed": true,
			"page-lockdown": true,
			"page-lockdown-logs": true,
			"page-lockdown-list": true,
			"page-lockdown-revisions": true
		},
		"confirmedusers": {
			"page-lockdown-read-confirmed": true,
			"page-lockdown-edit-confirmed": true
		},
		"sysop": {
			"page-lockdown-read": true,
			"page-lockdown-read-confirmed": true,
			"page-lockdown-edit": true,
			"page-lockdown-edit-confirmed": true,
			"page-lockdown": true,
			"page-lockdown-logs": true,
			"page-lockdown-list": true,
			"page-lockdown-revisions": true
		}
	},
	"AvailableRights": [
		"page-lockdown-read",
		"page-lockdown-read-confirmed",
		"page-lockdown-edit",
		"page-lockdown-edit-confirmed",
		"page-lockdown",
		"page-lockdown-revisions",
		"page-lockdown-logs",
		"page-lockdown-list"
	],
	"Hooks": {
		"LoadExtensionSchemaUpdates": "schema",
		"getUserPermissionsErrors": "main",
		"BeforeParserFetchTemplateRevisionRecord": "main",
		"PageDeleteComplete": "main",
		"InfoAction": "main",
		"BeforePageDisplay": "main",
		"SkinTemplateNavigation::Universal": "main",
		"GetLinkColours": "main",
		"EditPage::showReadOnlyForm:initial": "main",
		"EditPage::showEditForm:initial": "main",
		"RandomPageQuery": "main",
		"GetPreferences": "main",
		"MediaWikiServices": "services",
		"ArticleRevisionVisibilitySet": "revision",
		"ArticleContentOnDiff": "revision",
		"DifferenceEngineNewHeader": "revision",
		"DifferenceEngineOldHeader": "revision",
		"ApiCheckCanExecute": "api",
		"APIGetAllowedParams": "api",
		"ApiQueryBaseBeforeQuery": "api",
		"APIQueryAfterExecute": "api",
		"APIAfterExecute": "api"
	},
	"HookHandlers": {
		"schema": {
			"class": "MediaWiki\\Extension\\PageLockdown\\Hooks\\SchemaUpdater"
		},
		"main": {
			"class": "MediaWiki\\Extension\\PageLockdown\\Hooks\\PageLockdownHooks"
		},
		"api": {
			"class": "MediaWiki\\Extension\\PageLockdown\\Hooks\\ApiHooks",
			"services": [
				"DBLoadBalancer",
				"MainWANObjectCache"
			]
		},
		"revision": {
			"class": "MediaWiki\\Extension\\PageLockdown\\Hooks\\RevisionHooks"
		},
		"services": {
			"class": "MediaWiki\\Extension\\PageLockdown\\Hooks\\ServicesHook"
		}
	},
	"LogTypes": [
		"pagelockdown"
	],
	"LogNames": {
		"pagelockdown": "pagelockdownlog"
	},
	"LogHeaders": {
		"pagelockdown": "pagelockdownlogtext"
	},
	"LogActionsHandlers": {
		"pagelockdown/hide": "MediaWiki\\Extension\\PageLockdown\\PageLockdownLogFormatter",
		"pagelockdown/unhide": "MediaWiki\\Extension\\PageLockdown\\PageLockdownLogFormatter",
		"pagelockdown/*": "LogFormatter"
	},
	"LogRestrictions": {
		"pagelockdown": "page-lockdown-logs"
	},
	"Actions": {
		"page-lockdown": "MediaWiki\\Extension\\PageLockdown\\PageLockdownAction"
	},
	"APIModules": {
		"pagelockdown": "MediaWiki\\Extension\\PageLockdown\\API\\ApiPageLockdown",
		"pagelockdownrevision": "MediaWiki\\Extension\\PageLockdown\\API\\ApiPageLockdownRevision"
	},
	"ExtensionMessagesFiles": {
		"PageLockdownAlias": "PageLockdown.alias.php"
	},
	"SpecialPages": {
		"PageLockdownLockedPages": {
			"class": "MediaWiki\\Extension\\PageLockdown\\Special\\PageLockdownLockedPages",
			"services": []
		},
		"Revisionlock": {
			"class": "MediaWiki\\Extension\\PageLockdown\\Special\\PageLockdownSpecialRevisionLock",
			"services": [
				"PermissionManager"
			]
		},
		"PageLockdownLockedTitles": {
			"class": "MediaWiki\\Extension\\PageLockdown\\Special\\PageLockdownLockedTitles",
			"services": [
				"LinkBatchFactory",
				"DBLoadBalancer",
				"TitleFormatter"
			]
		}
	},
	"GrantPermissionGroups": {
		"pagelockdown": "administration"
	},
	"GrantPermissions": {
		"pagelockdown": {
			"page-lockdown-read": true,
			"page-lockdown-read-confirmed": true,
			"page-lockdown-edit": true,
			"page-lockdown-edit-confirmed": true,
			"page-lockdown": true,
			"page-lockdown-revisions": true
		}
	},
	"config": {
		"PageLockdownEnablePageviewersRead": {
			"value": true,
			"description": "Enable the read restriction that allows only pageviewers to read."
		},
		"PageLockdownEnablePageviewersEdit": {
			"value": false,
			"description": "Enable the edit restriction that allows only pageviewers to edit."
		},
		"PageLockdownEnableConfirmedRead": {
			"value": false,
			"description": "Enable the read restriction that allows only confirmedusers to read."
		},
		"PageLockdownEnablePageviewersConfirmedEdit": {
			"value": false,
			"description": "Enable the edit restriction that allows pageviewers and confirmedusers to edit."
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "PageLockdown/resources"
	},
	"ResourceModules": {
		"ext.pageLockdown.styles": {
			"styles": "ext.pageLockdown.css"
		},
		"ext.pageLockdown.messages": {
			"scripts": "ext.pageLockdown.messages.js",
			"messages": [
				"pl-notify-read",
				"pl-notify-read-semi",
				"pl-notify-edit-semi",
				"pl-notify-edit",
				"pl-notify-create",
				"pl-template-content-read",
				"pl-template-content-edit",
				"pl-template-content-edit-semi",
				"pl-template-content-read-semi",
				"pl-template-content-create"
			],
			"dependencies": [
				"mediawiki.util",
				"mediawiki.jqueryMsg",
				"mediawiki.user"
			]
		},
		"ext.pageLockdown.blockingFilteredPages": {
			"scripts": "ext.blockingFilteredPages.js",
			"dependencies": {
				"jquery": "jquery"
			}
		}
	},
	"DefaultUserOptions": {
		"page-lockdown-linksread": "0",
		"page-lockdown-linksedit": "0",
		"page-lockdown-linksedit-semi": "1",
		"page-lockdown-linksedit-full": "1",
		"page-lockdown-linksread-semi": "0",
		"page-lockdown-showread": "0",
		"page-lockdown-showedit": "1",
		"page-lockdown-showedit-semi": "1",
		"page-lockdown-showedit-full": "1",
		"page-lockdown-showread-semi": "0"
	}
}
